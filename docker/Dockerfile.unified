# ─────────────────────────────────────────────────────────────────────────────
# iAgents Hub — imagen unificada (backend + frontend en un solo contenedor)
#
# El contexto de build lo prepara gaia.sh push — contiene:
#   backend/   → código Python + requirements.txt
#   frontend/  → ficheros estáticos + nginx.conf
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: dependencias Python ─────────────────────────────────────────────
FROM python:3.12-slim AS py-builder
WORKDIR /build
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# Imagen con Chromium: el build usa `npm run prerender` (build + snapshot HTML
# de las rutas públicas) para que los buscadores reciban título, descripción y
# contenido sin ejecutar el bundle. Solo es stage de build: no engorda la final.
# El prerender genera estáticos independientes de la arquitectura. Ejecutarlo
# siempre en la plataforma nativa del builder evita lanzar Chromium bajo QEMU
# durante el target arm64, donde el proceso GPU termina con SIGTRAP.
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/playwright:v1.61.1-noble AS frontend-builder
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run prerender

# ── Stage 2: imagen final ─────────────────────────────────────────────────────
FROM python:3.12-slim

# Versión de build (formato YYYYMMDDHHMMSS, UTC) — la inyecta gaia.py push o
# el workflow de CI vía --build-arg. "dev" en builds locales sin el arg.
# Se usa en /api/admin/check-update para comparar contra Docker Hub.
ARG GAIA_VERSION=dev
ENV GAIA_VERSION=$GAIA_VERSION
LABEL org.iagentshub.version=$GAIA_VERSION

# Commit (SHA corto) de backend_fastapi y del frontend empaquetados en esta
# imagen — GAIA_VERSION solo dice "cuándo" se construyó, no "qué" código de
# cada repo lleva dentro. /api/admin/check-update los compara contra el HEAD
# de main de cada repo para detectar cuál de los dos está desactualizado.
ARG BACKEND_COMMIT=dev
ARG FRONTEND_COMMIT=dev
ENV BACKEND_COMMIT=$BACKEND_COMMIT
ENV FRONTEND_COMMIT=$FRONTEND_COMMIT
LABEL org.iagentshub.backend_commit=$BACKEND_COMMIT
LABEL org.iagentshub.frontend_commit=$FRONTEND_COMMIT

# nginx + supervisor + envsubst (gettext-base)
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx \
        supervisor \
        gettext-base \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default \
    && sed -i '/^\s*gzip on;$/d' /etc/nginx/nginx.conf

# Dependencias Python instaladas en stage anterior
COPY --from=py-builder /install /usr/local

# ── Backend ───────────────────────────────────────────────────────────────────
COPY backend/ /app/

# ── Frontend ──────────────────────────────────────────────────────────────────
COPY --from=frontend-builder /build/dist/ /usr/share/nginx/html/
COPY flutter-web/ /usr/share/nginx/html/app/

# nginx.conf → conf.d/default.conf. El `gzip on;` de fábrica de Debian en
# nginx.conf (ver arriba) se elimina para que el de aquí no choque con un
# "directive is duplicate" al arrancar nginx.
# · Sustituir proxy_pass → 127.0.0.1 (backend en el mismo contenedor)
COPY frontend/nginx.react.conf /etc/nginx/conf.d/default.conf
RUN sed -i 's|http://backend:8765|http://127.0.0.1:8765|g' /etc/nginx/conf.d/default.conf

# ── Supervisor ────────────────────────────────────────────────────────────────
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY entrypoint-unified.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80

# Valores por defecto sobreescribibles con -e en docker run / compose
ENV GAIA_DATA_DIR=/data \
    GAIA_HOST=127.0.0.1 \
    GAIA_PORT=8765 \
    GAIA_RELOAD=false \
    GAIA_WORKERS=4 \
    GAIA_TRUSTED_PROXIES=127.0.0.1

VOLUME ["/data"]

ENTRYPOINT ["/entrypoint.sh"]
