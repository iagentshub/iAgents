# ─────────────────────────────────────────────────────────────────────────────
# iAgents Hub — imagen unificada (backend + frontend en un solo contenedor)
#
# El contexto de build lo prepara gaia.sh push — contiene:
#   backend/   → código Python + requirements.txt
#   frontend/  → ficheros estáticos + nginx.conf
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: dependencias Python ─────────────────────────────────────────────
FROM python:3.12-slim AS py-builder
WORKDIR /build
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# Imagen con Chromium: el build usa `npm run prerender` (build + snapshot HTML
# de las rutas públicas) para que los buscadores reciban título, descripción y
# contenido sin ejecutar el bundle. Solo es stage de build: no engorda la final.
# El prerender genera estáticos independientes de la arquitectura. Ejecutarlo
# siempre en la plataforma nativa del builder evita lanzar Chromium bajo QEMU
# durante el target arm64, donde el proceso GPU termina con SIGTRAP.
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/playwright:v1.61.1-noble AS frontend-builder
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run prerender

# ── Stage 2: imagen final ─────────────────────────────────────────────────────
FROM python:3.12-slim

# Versión de build (formato YYYYMMDDHHMMSS, UTC) — la inyecta gaia.py push o
# el workflow de CI vía --build-arg. "dev" en builds locales sin el arg.
# Se usa en /api/admin/check-update para comparar contra GHCR.
ARG GAIA_VERSION=dev
ENV GAIA_VERSION=$GAIA_VERSION
LABEL org.iagentshub.version=$GAIA_VERSION
LABEL org.opencontainers.image.source="https://github.com/iagentshub/iAgents"

# Commit (SHA corto) de backend_fastapi, frontend_react y app_flutter
# empaquetados en esta imagen — GAIA_VERSION solo dice "cuándo" se construyó,
# no "qué" código de cada repo lleva dentro. /api/admin/check-update los
# compara contra el HEAD de main de cada repo para detectar cuál está
# desactualizado.
ARG BACKEND_COMMIT=dev
ARG FRONTEND_COMMIT=dev
ARG APP_COMMIT=dev
ENV BACKEND_COMMIT=$BACKEND_COMMIT
ENV FRONTEND_COMMIT=$FRONTEND_COMMIT
ENV APP_COMMIT=$APP_COMMIT
LABEL org.iagentshub.backend_commit=$BACKEND_COMMIT
LABEL org.iagentshub.frontend_commit=$FRONTEND_COMMIT
LABEL org.iagentshub.app_commit=$APP_COMMIT

# nginx + supervisor + envsubst (gettext-base)
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx \
        supervisor \
        gettext-base \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default \
    && sed -i '/^\s*gzip on;$/d' /etc/nginx/nginx.conf

# Dependencias Python instaladas en stage anterior
COPY --from=py-builder /install /usr/local

# ── Backend ───────────────────────────────────────────────────────────────────
COPY backend/ /app/

# ── Frontend ──────────────────────────────────────────────────────────────────
COPY --from=frontend-builder /build/dist/ /usr/share/nginx/html/
COPY flutter-web/ /usr/share/nginx/html/app/

# nginx.conf → conf.d/default.conf. El `gzip on;` de fábrica de Debian en
# nginx.conf (ver arriba) se elimina para que el de aquí no choque con un
# "directive is duplicate" al arrancar nginx.
# · La imagen standalone sustituye BACKEND_URL en runtime. En la imagen
#   unificada el backend siempre vive en el mismo contenedor, por lo que se
#   fija aquí y se valida la configuración durante el build.
COPY frontend/nginx.react.conf /etc/nginx/conf.d/default.conf
RUN sed -i 's|${BACKEND_URL}|http://127.0.0.1:8765|g' /etc/nginx/conf.d/default.conf \
    && nginx -t

# ── Supervisor ────────────────────────────────────────────────────────────────
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY entrypoint-unified.sh /entrypoint.sh
# El sed no sobra: `gaia.py push` construye desde una copia de trabajo, y en
# Windows con core.autocrlf este fichero llega con CRLF. El shebang queda como
# "#!/bin/sh\r" y el contenedor muere con "no such file or directory" señalando
# un intérprete que sí existe. CI no lo veía porque hace checkout en Linux.
# frontend_react/Dockerfile ya se protegía; este no.
RUN sed -i 's/\r$//' /entrypoint.sh \
    && chmod +x /entrypoint.sh

# ── Usuario sin privilegios ───────────────────────────────────────────────────
# El contenedor SIGUE arrancando como root: el entrypoint tiene que ceder /data
# antes de bajar privilegios (ver entrypoint-unified.sh).
#
# El puerto se queda en el 80. Cambiarlo obligaría a tocar el "${PORT}:80" de
# los composes y el de cualquiera que tenga el suyo; no hace falta, porque
# Docker arranca con net.ipv4.ip_unprivileged_port_start=0 y un usuario normal
# puede atar al 80. Si un runtime no lo permitiera, nginx fallaría al arrancar
# de forma ruidosa, no en silencio.
#
# Lo que se escribe en cada arranque: el pid y la caché de nginx, sus logs, el
# socket de supervisor y el env.js del cliente. env.js se pre-crea para
# cedérselo suelto en vez de dar /usr/share/nginx/html entero, que dejaría el
# sitio estático escribible por quien lo sirve.
# /run va con -R y no es un detalle: el `nginx -t` de más arriba corre como
# root durante el build y deja un /run/nginx.pid suyo. Ceder solo el directorio
# deja ese fichero fuera, y nginx muere al arrancar con "open() /run/nginx.pid
# failed (13: Permission denied)" pese a poder escribir en /run.
#
# La directiva `user` de nginx.conf se quita: solo tiene sentido si el master
# es root, y si no se toca escupe un aviso en cada arranque.
RUN useradd --system --create-home --uid 1000 gaia \
    && touch /usr/share/nginx/html/env.js \
    && mkdir -p /var/lib/nginx /var/log/nginx /run \
    && sed -i '/^user\s\+/d' /etc/nginx/nginx.conf \
    && chown -R gaia:gaia /var/lib/nginx /var/log/nginx /app /run \
    && chown gaia:gaia /usr/share/nginx/html/env.js

EXPOSE 80

# Valores por defecto sobreescribibles con -e en docker run / compose
ENV GAIA_DATA_DIR=/data \
    GAIA_HOST=127.0.0.1 \
    GAIA_PORT=8765 \
    GAIA_RELOAD=false \
    GAIA_WORKERS=4 \
    GAIA_LLM_MAX_THREADS=16 \
    GAIA_TRUSTED_PROXIES=127.0.0.1

VOLUME ["/data"]

ENTRYPOINT ["/entrypoint.sh"]
